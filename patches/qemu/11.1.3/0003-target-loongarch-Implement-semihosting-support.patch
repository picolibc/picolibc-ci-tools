diff --git a/target/loongarch/common-semi-target.c b/target/loongarch/common-semi-target.c
new file mode 100644
index 0000000..cc1220b
--- /dev/null
+++ b/target/loongarch/common-semi-target.c
@@ -0,0 +1,44 @@
+/*
+ * Target-specific parts of semihosting/arm-compat-semi.c.
+ *
+ * Copyright (c) 2024 Jiaxun Yang <jiaxun.yang@flygoat.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "semihosting/common-semi.h"
+
+uint64_t common_semi_arg(CPUState *cs, int argno)
+{
+    CPULoongArchState *env = cpu_env(cs);
+    return env->gpr[4 + argno];
+}
+
+void common_semi_set_ret(CPUState *cs, uint64_t ret)
+{
+    CPULoongArchState *env = cpu_env(cs);
+    env->gpr[4] = ret;
+}
+
+bool is_64bit_semihosting(CPUArchState *env)
+{
+    return !is_va32(env);
+}
+
+bool common_semi_sys_exit_is_extended(CPUState *cs)
+{
+    return is_64bit_semihosting(cpu_env(cs));
+}
+
+uint64_t common_semi_stack_bottom(CPUState *cs)
+{
+    CPULoongArchState *env = cpu_env(cs);
+    return env->gpr[3];
+}
+
+bool common_semi_has_synccache(CPUArchState *env)
+{
+    return true;
+}
diff --git a/target/loongarch/cpu.h b/target/loongarch/cpu.h
index ad30c73..fc3f7ac 100644
--- a/target/loongarch/cpu.h
+++ b/target/loongarch/cpu.h
@@ -95,6 +95,9 @@ FIELD(FCSR0, CAUSE, 24, 5)
 #define  EXCCODE_BTE                 EXCODE(21, 0)
 #define  EXCCODE_DBP                 EXCODE(26, 0) /* Reserved subcode used for debug */
 
+/* QEMU Internal Exceptions */
+#define  EXCCODE_SEMIHOST            EXCODE(63, 0)
+
 /* cpucfg[0] bits */
 FIELD(CPUCFG0, PRID, 0, 12)
 FIELD(CPUCFG0, SERID, 12, 4)

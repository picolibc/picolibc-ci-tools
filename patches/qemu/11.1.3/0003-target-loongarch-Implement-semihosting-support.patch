+                 if_true: files('common-semi-target.c'))
 
 loongarch_user_ss = ss.source_set()
 loongarch_user_ss.add(files('gdbstub.c'))
diff --git a/target/loongarch/tcg/insn_trans/trans_privileged.c.inc b/target/loongarch/tcg/insn_trans/trans_privileged.c.inc
index 6728ce5..44fcf15 100644
--- a/target/loongarch/tcg/insn_trans/trans_privileged.c.inc
+++ b/target/loongarch/tcg/insn_trans/trans_privileged.c.inc
@@ -7,6 +7,28 @@
 
 #include "csr.h"
 
+static bool check_plv(DisasContext *ctx)
+{
+    if (ctx->plv == MMU_PLV_USER) {
+        generate_exception(ctx, EXCCODE_IPE);
+        return true;
+    }
+    return false;
+}
+
+static bool trans_dbcl(DisasContext *ctx, arg_dbcl *a)
+{
+    if (semihosting_enabled(ctx->plv == MMU_PLV_USER) && a->imm == 0xab) {
+        generate_exception(ctx, EXCCODE_SEMIHOST);
+        return true;
+    }
+    if (check_plv(ctx)) {
+        return false;
+    }
+    generate_exception(ctx, EXCCODE_DBP);
+    return true;
+}
+

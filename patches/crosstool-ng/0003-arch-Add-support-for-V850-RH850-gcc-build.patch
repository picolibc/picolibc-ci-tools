From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Parthiban Nallathambi <parthiban@linumiz.com>
Date: Sat, 31 Oct 2026 12:19:07 +0530
Subject: [PATCH] arch: Add support for V850/RH850 gcc build

Add the v850 architecture and a v850-unknown-elf sample. GCC, binutils,
GDB and newlib already support v850; core options such as -mv850e3v5
(RH850 G4KH) are selected through multilib.

Signed-off-by: Parthiban Nallathambi <parthiban@linumiz.com>
---
 config/arch/v850.in                       | 8 ++++++++
 samples/v850-unknown-elf/crosstool.config | 4 ++++
 samples/v850-unknown-elf/reported.by      | 3 +++
 scripts/build/arch/v850.sh                | 5 +++++
 4 files changed, 20 insertions(+)
 create mode 100644 config/arch/v850.in
 create mode 100644 samples/v850-unknown-elf/crosstool.config
 create mode 100644 samples/v850-unknown-elf/reported.by
 create mode 100644 scripts/build/arch/v850.sh

diff --git a/config/arch/v850.in b/config/arch/v850.in
new file mode 100644
index 00000000..0a86ddb9
--- /dev/null
+++ b/config/arch/v850.in
@@ -0,0 +1,8 @@
+## no-package
+## select ARCH_SUPPORTS_32
+## select ARCH_DEFAULT_32
+## select ARCH_SUPPORTS_FLAT_FORMAT
+## select ARCH_DEFAULT_LE
+## select ARCH_REQUIRES_MULTILIB
+
+## help The Renesas V850 and RH850 architecture.
diff --git a/samples/v850-unknown-elf/crosstool.config b/samples/v850-unknown-elf/crosstool.config
new file mode 100644
index 00000000..e14d0d23
--- /dev/null
+++ b/samples/v850-unknown-elf/crosstool.config
@@ -0,0 +1,4 @@
+CT_CONFIG_VERSION="4"
+CT_EXPERIMENTAL=y
+CT_ARCH_V850=y
+CT_DEBUG_GDB=y
diff --git a/samples/v850-unknown-elf/reported.by b/samples/v850-unknown-elf/reported.by
new file mode 100644
index 00000000..96dba72b
--- /dev/null
+++ b/samples/v850-unknown-elf/reported.by
@@ -0,0 +1,3 @@
+reporter_name="Parthiban Nallathambi <parthiban@linumiz.com>"
+reporter_url=""
+reporter_comment="Example building a toolchain for V850/RH850 bare metal target"
diff --git a/scripts/build/arch/v850.sh b/scripts/build/arch/v850.sh
new file mode 100644
index 00000000..7d58ce7a
--- /dev/null
+++ b/scripts/build/arch/v850.sh
@@ -0,0 +1,5 @@
+# Compute v850 values
+
+CT_DoArchTupleValues() {
+    :;
+}
-- 
Parthiban N

